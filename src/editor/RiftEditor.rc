// RIFT Editor resources: application icon and version information.
#pragma code_page(65001)
#include "resource.h"
#include <winres.h>

IDI_APP_ICON ICON "rift.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RIFT_VERSION_MAJOR,RIFT_VERSION_MINOR,RIFT_VERSION_PATCH,0
 PRODUCTVERSION RIFT_VERSION_MAJOR,RIFT_VERSION_MINOR,RIFT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RIFT"
            VALUE "FileDescription", "RIFT Editor"
            VALUE "FileVersion", RIFT_VERSION_STRING
            VALUE "InternalName", "RiftEditor"
            VALUE "OriginalFilename", "RiftEditor.exe"
            VALUE "ProductName", "RIFT Engine"
            VALUE "ProductVersion", RIFT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

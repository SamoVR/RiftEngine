<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shared by every RIFT project (ThirdParty, RiftCore, RiftEditor, RiftPlayer, RiftTests).
  Output:        build\bin\<Configuration>\        (executables)
  Intermediate:  build\obj\<Project>\<Configuration>\
  The engine finds its data\ folder by itself (see src\core\Paths.cpp), so the
  working directory does not matter when running or debugging.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <RiftRoot>$(MSBuildThisFileDirectory)</RiftRoot>
    <RiftThirdParty>$(RiftRoot)third_party\</RiftThirdParty>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <!-- Everything is vendored in third_party\. A machine-wide vcpkg
         integration would otherwise auto-link its own (DLL) GLFW. -->
    <VcpkgEnabled>false</VcpkgEnabled>
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(RiftRoot)build\bin\$(Configuration)\</OutDir>
    <IntDir>$(RiftRoot)build\obj\$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(RiftRoot)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 /bigobj /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;GLEW_STATIC;GLM_ENABLE_EXPERIMENTAL;SOL_USING_CXX_LUA=1;SOL_ALL_SAFETIES_ON=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RiftRoot)src;$(RiftThirdParty)imgui;$(RiftThirdParty)imgui\backends;$(RiftThirdParty)imguizmo;$(RiftThirdParty)fontawesome;$(RiftThirdParty)glfw\include;$(RiftThirdParty)glew\include;$(RiftThirdParty)glm;$(RiftThirdParty)json;$(RiftThirdParty)stb;$(RiftThirdParty)lua;$(RiftThirdParty)sol2\include;$(RiftThirdParty)discord;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OutDir);$(RiftThirdParty)discord\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <!-- Engine code includes glew.h itself; GLFW must not pull in gl.h. (GLFW's own
       sources refuse this macro, so ThirdParty is excluded.) -->
  <ItemDefinitionGroup Condition="'$(ProjectName)'!='ThirdParty'">
    <ClCompile>
      <PreprocessorDefinitions>GLFW_INCLUDE_NONE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;RIFT_DEBUG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>

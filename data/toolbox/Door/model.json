   "id": "00000000007b0007",
   "name": "DoorScript",
   "parent": "00000000007b0005",
   "_text": "-- Slides the door up and down when a player presses E at it.\nlocal panel = script.Parent\nlocal prompt = panel:WaitForChild(\"ProximityPrompt\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal closed = panel.CFrame\nlocal isOpen = false\n\nprompt.Triggered:Connect(function(player)\n\tisOpen = not isOpen\n\tprompt.ActionText = isOpen and \"Close\" or \"Open\"\n\tlocal goal = isOpen and closed * CFrame.new(0, panel.Size.Y - 0.3, 0) or closed\n\tTweenService:Create(panel, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { CFrame = goal }):Play()\nend)\n"
  }
